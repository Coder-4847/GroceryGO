# Copy to .env.local for local overrides, or set these in the GitHub Pages build.

# Base URL of the deployed backend API. Leave unset locally (Vite proxies /api).
# In production set this to your backend service URL (NO trailing slash):
#   VITE_API_BASE=https://grocerygo-api.onrender.com
VITE_API_BASE=

# GitHub Pages serves the app from https://<user>.github.io/<repo>/, so the build
# needs a matching base path. The deploy workflow sets this automatically from
# the repo name; only set it by hand for a non-standard path.
#   VITE_BASE=/grocerygo/
VITE_BASE=/

# Local dev only: where `npm run dev` proxies /api to.
VITE_DEV_API_TARGET=http://localhost:3001

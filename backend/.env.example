# --- GroceryGO backend configuration -------------------------------------
# Copy to .env and adjust as needed. All values have sane defaults.

PORT=3001

# Comma-separated list of allowed frontend origins (any *.github.io is always allowed).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cache TTLs (ms)
CACHE_TTL_MS=1200000          # 20 min for a successful retailer result
CACHE_ERROR_TTL_MS=180000     # 3 min before retrying a failed retailer

# Per-retailer scrape ceiling (ms)
SCRAPER_TIMEOUT_MS=25000

# How many retailers to scrape at once
SCRAPER_CONCURRENCY=4

# Minimum gap between two hits to the same retailer host (ms)
PER_HOST_MIN_GAP_MS=1500

# API rate limit: requests per minute per IP
RATE_LIMIT_MAX=20

# Browser: Carrefour + Noon require HEADED real Chrome to get past Akamai.
# Leave HEADLESS unset (headed). On a headless Linux host run under xvfb:
#   xvfb-run -a npm start
HEADLESS=
BROWSER_CHANNEL=chrome        # set to "chromium" to use Playwright's bundled build

# Respect robots.txt disallow rules (recommended). Set to 0 only for local debugging.
RESPECT_ROBOTS=1

# Save HTML + screenshot of failed scrapes to ./scraper-debug
DEBUG_ARTIFACTS=0

LOG_LEVEL=info

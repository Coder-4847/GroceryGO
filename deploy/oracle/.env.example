# Copy to .env and fill in. Do NOT commit .env.

# Your DuckDNS (or other) domain that points at this VM's public IP.
DOMAIN=grocerygo.duckdns.org

# Optional: email for Let's Encrypt expiry notices.
ACME_EMAIL=

# Optional: extra allowed CORS origin (any https://*.github.io already works).
CORS_ORIGINS=
